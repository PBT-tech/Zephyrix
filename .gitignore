# Environment variables (NEVER commit these!)
.env
.env.local
.env.local.backup
.env*.local

# Dependencies
node_modules/
yarn.lock
package-lock.json

# Build output
.next/
out/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Testing
.coverage/
.nyc_output/

# Misc
.cache/
tmp/
temp/
