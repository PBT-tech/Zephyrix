    # ========== Helper Methods ==========

    def _format_schedule(self, task_data):
        """Format schedule for display"""
        recurrence = task_data.get('recurrence', 'weekly')
        days = task_data.get('days', '1,4')
        hour = task_data.get('hour', '9')
        minute = task_data.get('minute', '33')

        day_names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

        if recurrence == 'daily':
            return f"Daily at {hour}:{minute.zfill(2)}"
        elif recurrence == 'weekly':
            day_list = [day_names[int(d)] for d in days.split(',')]
            return f"{', '.join(day_list)} at {hour}:{minute.zfill(2)}"
        elif recurrence == 'monthly':
            return f"1st of month at {hour}:{minute.zfill(2)}"
        else:
            return f"Once at {hour}:{minute.zfill(2)}"

    def _calculate_next_run(self, task_data):
        """Calculate when task will next run"""
        return datetime.now().strftime('%B %d, %Y at %H:%M')

    def _get_next_task_number(self):
        """Get next task number"""
        content = self._read_file(self.specs_file)
        count = content.count('## TASK ')
        return count + 1

