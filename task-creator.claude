#!/usr/bin/env claude
# Task Management System - Task Creator & Manager
# Handles creating, editing, and deleting tasks in the comprehensive task management system
# Updates all files automatically: TASKS-SPECIFICATIONS.md, TASKS-CALENDAR-AND-EDITOR.md, master-state.md, indexes

"""
TASK CREATOR - Claude Code Script
Purpose: Backend for task management dashboard
Handles: Creating tasks, updating specs, generating scripts, updating all references

Usage:
  claude run task-creator.claude create --name "Task Name" --id "task-id" --schedule "weekly" --days "1,4" --hour "9" --minute "33"
  claude run task-creator.claude edit --id "task-id" --status "MIGRATE"
  claude run task-creator.claude list
  claude run task-creator.claude generate-scripts
"""

import os
import json
from datetime import datetime
from pathlib import Path

# Configuration
VAULT_PATH = Path.home() / "ClaudeCowork" / "Tara-second-Brain"
AIBOS_PATH = VAULT_PATH / "_aibos"
SPECS_FILE = AIBOS_PATH / "TASKS-SPECIFICATIONS.md"
CALENDAR_FILE = AIBOS_PATH / "TASKS-CALENDAR-AND-EDITOR.md"
STATE_FILE = AIBOS_PATH / "master-state.md"
SCRIPTS_PATH = AIBOS_PATH / "claude-code-scripts"

# Ensure directories exist
SCRIPTS_PATH.mkdir(exist_ok=True)

class TaskManager:
    def __init__(self):
        self.specs_file = SPECS_FILE
        self.calendar_file = CALENDAR_FILE
        self.state_file = STATE_FILE
        self.scripts_path = SCRIPTS_PATH

    def create_task(self, task_data):
        """Create a new task with full spec"""
        task_id = task_data.get('id')
        task_name = task_data.get('name')
        status = task_data.get('status', 'PENDING')
        priority = task_data.get('priority', 'MEDIUM')

        print(f"✨ Creating task: {task_name} ({task_id})")

        # 1. Add to TASKS-SPECIFICATIONS.md
        self._add_to_specifications(task_data)
        print(f"  ✅ Updated TASKS-SPECIFICATIONS.md")

        # 2. Add to TASKS-CALENDAR-AND-EDITOR.md
        self._add_to_calendar(task_data)
        print(f"  ✅ Updated TASKS-CALENDAR-AND-EDITOR.md")

        # 3. Add to master-state.md
        self._add_to_master_state(task_data)
        print(f"  ✅ Updated master-state.md")

        # 4. Generate Claude Code script
        self._generate_claude_code_script(task_data)
        print(f"  ✅ Generated Claude Code script: {task_id}.claude")

        # 5. Generate test script
        self._generate_test_script(task_data)
        print(f"  ✅ Generated test script: {task_id}-TEST.claude")

        # 6. Update indexes
        self._update_indexes(task_data)
        print(f"  ✅ Updated entity indexes")

        print(f"\n✅ Task '{task_name}' created successfully!")
        print(f"   Schedule: {self._format_schedule(task_data)}")
        print(f"   Next run: {self._calculate_next_run(task_data)}")

        return True

    def edit_task(self, task_id, updates):
        """Edit an existing task"""
        print(f"✏️ Editing task: {task_id}")

        # Read current specs
        specs = self._read_file(self.specs_file)

        # Find and update task section
        updated_specs = self._update_task_section(specs, task_id, updates)

        # Write back
        self._write_file(self.specs_file, updated_specs)
        print(f"  ✅ Updated task specifications")

        # Regenerate script
        task_data = {**updates, 'id': task_id}
        self._generate_claude_code_script(task_data)
        print(f"  ✅ Regenerated Claude Code script")

        print(f"\n✅ Task '{task_id}' updated successfully!")
        return True

    def list_tasks(self):
        """List all tasks with their status"""
        print("\n📋 All Tasks:\n")

        # Read master-state.md for current status
        state = self._read_file(self.state_file)

        # Parse tasks from status
        tasks = self._parse_tasks_from_state(state)

        for task in tasks:
            print(f"  {task['name']}")
            print(f"    ID: {task['id']}")
            print(f"    Schedule: {task['schedule']}")
            print(f"    Status: {task['status']}")
            print(f"    Next run: {task['next_run']}\n")

        return True

    def generate_all_scripts(self):
        """Generate Claude Code scripts for all tasks"""
        print("⚙️ Generating Claude Code scripts...\n")

        specs = self._read_file(self.specs_file)
        tasks = self._parse_tasks_from_specs(specs)

        for task in tasks:
            print(f"  Generating script for: {task['name']}")
            self._generate_claude_code_script(task)
            self._generate_test_script(task)

        print(f"\n✅ Generated {len(tasks)} scripts")
        return True

    # ========== File Operations ==========

    def _read_file(self, path):
        """Read file content"""
        try:
            with open(path, 'r') as f:
                return f.read()
        except FileNotFoundError:
            return ""

    def _write_file(self, path, content):
        """Write file content"""
        with open(path, 'w') as f:
            f.write(content)

    def _add_to_specifications(self, task_data):
        """Add task to TASKS-SPECIFICATIONS.md"""
        content = self._read_file(self.specs_file)

        # Create task section
        task_section = f"""
## TASK {self._get_next_task_number()}: {task_data.get('name')}

**Task ID:** `{task_data.get('id')}`
**Schedule:** {self._format_schedule(task_data)}
**Status:** {task_data.get('status', 'PENDING')} ✓

### What It Does
{task_data.get('description', '[INSTRUCTION NEEDED]')}

### Files Read
{task_data.get('inputs', '[INSTRUCTION NEEDED]')}

### Files Written
{task_data.get('outputs', '[INSTRUCTION NEEDED]')}

### Success Criteria
{task_data.get('success_criteria', '[INSTRUCTION NEEDED]')}

### Approval Flow
- **Needs Approval?** {task_data.get('approval', 'NO')}
- **Auto-update if:** No changes found

### Notes
- Created: {datetime.now().strftime('%B %d, %Y')}
- Health status: Pending
- Next run: {self._calculate_next_run(task_data)}

"""

        # Append to file
        content += task_section
        self._write_file(self.specs_file, content)

    def _add_to_calendar(self, task_data):
        """Add task to TASKS-CALENDAR-AND-EDITOR.md"""
        content = self._read_file(self.calendar_file)

        # Add calendar entry and edit section
        calendar_entry = f"""

### Task {self._get_next_task_number()}: {task_data.get('name')}

**Status:** {task_data.get('status')}
**Schedule:** {self._format_schedule(task_data)}
**Time:** {task_data.get('hour')}:{task_data.get('minute').zfill(2)}
**Priority:** {task_data.get('priority', 'MEDIUM')}

"""

        content += calendar_entry
        self._write_file(self.calendar_file, content)

    def _add_to_master_state(self, task_data):
        """Add task to master-state.md"""
        content = self._read_file(self.state_file)

        state_entry = f"""
### {self._get_next_task_number()}. {task_data.get('name')} ({self._format_schedule(task_data)})
- **Task ID:** {task_data.get('id')}
- **Frequency:** {self._format_schedule(task_data)}
- **Last run:** TBD (awaiting deployment)
- **Next run:** {self._calculate_next_run(task_data)}
- **Status:** {task_data.get('status')} {'✓' if task_data.get('status') == 'ENABLED' else ''}
- **Health:** {'Healthy' if task_data.get('status') == 'ENABLED' else 'Pending'}
- **Output location:** {task_data.get('outputs', 'TBD').split(',')[0] if task_data.get('outputs') else 'TBD'}
- **Notes:** {task_data.get('name')} - Created {datetime.now().strftime('%B %d, %Y')}

"""

        content += state_entry
        self._write_file(self.state_file, content)

    def _generate_claude_code_script(self, task_data):
        """Generate Claude Code script for task"""
        script_path = self.scripts_path / f"{task_data.get('id')}.claude"

        script_template = f"""#!/usr/bin/env claude
# {task_data.get('name')}
# Task ID: {task_data.get('id')}
# Schedule: {self._format_schedule(task_data)}
# Status: {task_data.get('status')}

'''
{task_data.get('name')}

Schedule: {self._format_schedule(task_data)}
Time: {task_data.get('hour')}:{task_data.get('minute').zfill(2)} (UTC+10)

What it does:
{task_data.get('description')}

Files read:
{task_data.get('inputs')}

Files written:
{task_data.get('outputs')}

Success criteria:
{task_data.get('success_criteria')}

Approval required: {task_data.get('approval', 'NO')}
'''

