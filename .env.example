# ============================================================================
# ZEPHYRIX - Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to git (add to .gitignore)
# ============================================================================

# ============================================================================
# SUPABASE Configuration
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://mtmfdluwdqwnekswvyfl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ============================================================================
# STRIPE Configuration (for payments)
# ============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxx

# ============================================================================
# JWT Configuration (for authentication)
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# ============================================================================
# Encryption Configuration (for API keys)
# ============================================================================
ENCRYPTION_KEY=your_encryption_key_here_change_this

# ============================================================================
# HighLevel Configuration (for email integration)
# ============================================================================
HIGHLEVEL_API_KEY=your_highlevel_api_key_here

# ============================================================================
# Claude/LLM Configuration (for task execution)
# ============================================================================
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=optional_openai_api_key
MANUS_API_KEY=optional_manus_api_key

# ============================================================================
# Application Configuration
# ============================================================================
NEXT_PUBLIC_APP_URL=https://zephyrix.platinumbusinessteams.com
NEXT_PUBLIC_APP_NAME=ZEPHYRIX
NODE_ENV=production

# ============================================================================
# How to get these values:
# ============================================================================
#
# SUPABASE_URL & KEYS:
#   1. Go to https://mtmfdluwdqwnekswvyfl.supabase.co
#   2. Click Settings → API
#   3. Copy Project URL, anon key, and service_role key
#
# STRIPE KEYS:
#   1. Go to https://dashboard.stripe.com
#   2. Click Developers → API Keys
#   3. Copy Publishable key and Secret key
#   4. Create webhook at Developers → Webhooks
#
# JWT_SECRET & ENCRYPTION_KEY:
#   Generate random strings:
#   - openssl rand -base64 32
#   - Or use: https://www.uuidgenerator.net/
#
# HIGHLEVEL_API_KEY:
#   1. Go to your HighLevel account
#   2. Settings → API Keys
#   3. Create new key, copy it
#
# CLAUDE_API_KEY:
#   1. Go to https://console.anthropic.com
#   2. API Keys
#   3. Create new key, copy it
#
# ============================================================================
