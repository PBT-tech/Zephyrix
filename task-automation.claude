#!/usr/bin/env claude
# ============================================================================
# TASK AUTOMATION SYSTEM - Complete Backend
# ============================================================================
# Purpose: Fully automate task management system
# Input: tasks.json (created by dashboard)
# Output: All files auto-updated, scripts generated, ready to run
# ============================================================================

import json
import os
from pathlib import Path
from datetime import datetime, timedelta

class TaskAutomation:
    def __init__(self):
        self.vault_path = Path.home() / "ClaudeCowork" / "Tara-second-Brain"
        self.aibos_path = self.vault_path / "_aibos"
        self.specs_file = self.aibos_path / "TASKS-SPECIFICATIONS.md"
        self.calendar_file = self.aibos_path / "TASKS-CALENDAR-AND-EDITOR.md"
        self.state_file = self.aibos_path / "master-state.md"
        self.scripts_path = self.aibos_path / "claude-code-scripts"
        self.tasks_json = self.aibos_path / "tasks.json"

        # Ensure directories exist
        self.scripts_path.mkdir(exist_ok=True)
        self.aibos_path.mkdir(exist_ok=True)

    def process_all_tasks(self):
        """Main automation: Read tasks.json and update everything"""
        print("🤖 TASK AUTOMATION SYSTEM")
        print("=" * 60)

        # Check if tasks.json exists
        if not self.tasks_json.exists():
            print("ℹ️  No tasks.json found. No tasks to process.")
            return False

        # Read tasks
        try:
            with open(self.tasks_json, 'r') as f:
                tasks_data = json.load(f)
        except Exception as e:
            print(f"❌ Error reading tasks.json: {e}")
            return False

        print(f"📋 Found {len(tasks_data.get('tasks', []))} tasks to process\n")

        # Process each task
        for task in tasks_data.get('tasks', []):
            self._process_single_task(task)

        # Update master index
        self._update_master_index(tasks_data)

        print("\n" + "=" * 60)
        print("✅ ALL TASKS PROCESSED AND READY")
        print(f"   Specifications: {self.specs_file}")
        print(f"   Calendar: {self.calendar_file}")
        print(f"   Status: {self.state_file}")
        print(f"   Scripts: {self.scripts_path}")
        print("\n🚀 Ready to run: Tasks are scheduled and ready to execute")

        return True

    def _process_single_task(self, task):
        """Process a single task: create specs, scripts, etc."""
        task_id = task.get('id')
        task_name = task.get('name')

        print(f"📝 Processing: {task_name}")

        # 1. Create specification
        self._create_specification(task)

        # 2. Create calendar entry
        self._create_calendar_entry(task)

        # 3. Create status entry
        self._create_status_entry(task)

        # 4. Generate Claude Code script
        self._generate_main_script(task)

        # 5. Generate test script
        self._generate_test_script(task)

        # 6. Update entity indexes
        self._update_entity_index(task)

        print(f"   ✅ Complete\n")

    def _create_specification(self, task):
        """Create task specification section"""
        spec_template = f"""## TASK: {task.get('name')}

**Task ID:** `{task.get('id')}`
**Schedule:** {self._format_schedule(task)}
**Status:** {task.get('status', 'PENDING')}

### What It Does
{task.get('description', '[Description needed]')}

### Files Read
{self._format_paths(task.get('inputs', []))}

### Files Written
{self._format_paths(task.get('outputs', []))}

### Success Criteria
{task.get('success_criteria', '[Success criteria needed]')}

### Approval Flow
- **Needs Approval?** {task.get('approval', 'NO')}
- **Approval Method:** {task.get('approval_method', 'Manual review')}

### Notes
- Created: {datetime.now().strftime('%B %d, %Y')}
- Health: Pending deployment
- Next run: {self._calculate_next_run(task)}

---

"""

        # Append to specifications file
        current = self._read_file(self.specs_file) if self.specs_file.exists() else ""
        self._write_file(self.specs_file, current + spec_template)

    def _create_calendar_entry(self, task):
        """Create calendar entry"""
        entry = f"""
### {task.get('name')}
- **Status:** {task.get('status')}
- **Schedule:** {self._format_schedule(task)}
- **Time:** {task.get('hour')}:{str(task.get('minute')).zfill(2)} (UTC+10)
- **Priority:** {task.get('priority', 'MEDIUM')}
- **Task ID:** {task.get('id')}

"""

        current = self._read_file(self.calendar_file) if self.calendar_file.exists() else ""
        self._write_file(self.calendar_file, current + entry)

    def _create_status_entry(self, task):
        """Create status entry in master-state.md"""
        entry = f"""
### {task.get('name')} ({self._format_schedule(task)})
- **Task ID:** {task.get('id')}
- **Frequency:** {self._format_schedule(task)}
- **Last run:** Not yet executed
- **Next run:** {self._calculate_next_run(task)}
- **Status:** {task.get('status')} {'✓' if task.get('status') == 'ENABLED' else ''}
- **Health:** {'Healthy' if task.get('status') == 'ENABLED' else 'Pending'}
- **Output location:** {self._format_paths(task.get('outputs', []))}
- **Notes:** Created {datetime.now().strftime('%B %d, %Y')}

"""

        current = self._read_file(self.state_file) if self.state_file.exists() else ""
        self._write_file(self.state_file, current + entry)

    def _generate_main_script(self, task):
        """Generate main Claude Code script for task"""
        script_path = self.scripts_path / f"{task.get('id')}.claude"

        script = f"""#!/usr/bin/env claude
# {task.get('name')}
# Task ID: {task.get('id')}
# Schedule: {self._format_schedule(task)}
# Status: {task.get('status')}

'''
{task.get('name')}

What it does:
{task.get('description')}

Schedule: {self._format_schedule(task)} at {task.get('hour')}:{str(task.get('minute')).zfill(2)} UTC+10

Files read:
{self._format_paths(task.get('inputs', []))}

Files written:
{self._format_paths(task.get('outputs', []))}

Success criteria:
{task.get('success_criteria')}

Approval required: {task.get('approval', 'NO')}
'''

import os
from pathlib import Path
from datetime import datetime

def main():
    print(f"🚀 Running: {task.get('name')}")
    print(f"   Scheduled: {datetime.now().isoformat()}")

    # TODO: Implement task logic here
    # 1. Read input files from: {self._format_paths(task.get('inputs', []))}
    # 2. Process data according to task description
    # 3. Write outputs to: {self._format_paths(task.get('outputs', []))}
    # 4. Update /_aibos/master-state.md with completion time
    # 5. Return success/failure status

