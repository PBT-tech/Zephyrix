        with open(script_path, 'w') as f:
            f.write(script)

    def _generate_test_script(self, task):
        """Generate test (dry-run) script"""
        script_path = self.scripts_path / f"{task.get('id')}-TEST.claude"

        script = f"""#!/usr/bin/env claude
# TEST VERSION: {task.get('name')}
# Dry-run mode - no files will be modified

def test_run():
    print(f"🧪 TEST: {task.get('name')}")
    print(f"   Status: DRY-RUN (no changes will be made)")
    print(f"")
    print(f"   Input files: {self._format_paths(task.get('inputs', []))}")
    print(f"   Output files (would write): {self._format_paths(task.get('outputs', []))}")
    print(f"   Success criteria: {task.get('success_criteria')}")
    print(f"")
    print(f"✅ Test completed (dry-run)")
    return True

if __name__ == "__main__":
    test_run()
"""

        with open(script_path, 'w') as f:
            f.write(script)

    def _update_entity_index(self, task):
        """Update entity-specific index"""
        task_id = task.get('id', '').lower()

        # Determine entity
        if 'pibs' in task_id or 'social' in task_id.lower():
            index_file = self.vault_path / "PIBS" / "00-INDEX.md"
        elif 'personal' in task_id:
            index_file = self.vault_path / "personal" / "00-INDEX.md"
        elif 'rlf' in task_id or 'pbt' in task_id:
            index_file = self.vault_path / "PBT" / "00-INDEX.md"
        else:
            return

        if not index_file.exists():
            return

        # Add task reference (implementation would add actual reference)

    def _update_master_index(self, tasks_data):
        """Update the master script index"""
        index_path = self.scripts_path / "00-SCRIPT-INDEX.md"

        index = f"""---
type: index
entity: vault
category: automation
last_updated: {datetime.now().strftime('%Y-%m-%d %H:%M')}
---

# Claude Code Scripts Index

**Total Scripts:** {len(tasks_data.get('tasks', []))}
**Last Updated:** {datetime.now().strftime('%B %d, %Y at %H:%M')}
**Status:** All ready to run

---

## Scripts

"""

        for task in tasks_data.get('tasks', []):
            index += f"""
### {task.get('name')}
- **ID:** {task.get('id')}
- **Schedule:** {self._format_schedule(task)}
- **Status:** {task.get('status')}
- **Script:** `{task.get('id')}.claude`
- **Test:** `{task.get('id')}-TEST.claude`

"""

        self._write_file(index_path, index)

    # ========== Helper Methods ==========

    def _format_schedule(self, task):
        """Format schedule string"""
        recurrence = task.get('recurrence', 'weekly')
        days = task.get('days', [])
        hour = task.get('hour', 9)
        minute = task.get('minute', 0)

        day_names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

        if recurrence == 'daily':
            return f"Daily at {hour}:{str(minute).zfill(2)}"
        elif recurrence == 'weekly':
            day_list = [day_names[int(d)] for d in (days if isinstance(days, list) else [])]
            if day_list:
                return f"{', '.join(day_list)} at {hour}:{str(minute).zfill(2)}"
            return f"Weekly at {hour}:{str(minute).zfill(2)}"
        elif recurrence == 'monthly':
            return f"1st of month at {hour}:{str(minute).zfill(2)}"
        else:
            return f"Once at {hour}:{str(minute).zfill(2)}"

    def _calculate_next_run(self, task):
        """Calculate next run time"""
        return datetime.now().strftime('%B %d, %Y')

    def _format_paths(self, paths):
        """Format paths list"""
        if isinstance(paths, list) and paths:
            return "\n".join([f"- {p}" for p in paths])
        elif isinstance(paths, str) and paths:
            return f"- {paths}"
        return "- (none specified)"

    def _read_file(self, path):
        """Read file"""
        try:
            with open(path, 'r') as f:
                return f.read()
        except:
            return ""

    def _write_file(self, path, content):
        """Write file"""
        try:
            with open(path, 'w') as f:
                f.write(content)
        except Exception as e:
            print(f"❌ Error writing {path}: {e}")

# Main execution
if __name__ == "__main__":
    automation = TaskAutomation()
    success = automation.process_all_tasks()

    if success:
        print("\n✅ Automation complete!")
    else:
        print("\n⚠️  Automation encountered issues")
