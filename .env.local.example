# ============================================================================
# ZEPHYRIX - Simplified Environment Setup (No API Keys Required)
# ============================================================================
# Copy this to .env.local and fill in ONLY the Supabase values
# Everything else is optional - add features later when you have the keys
# ============================================================================

# ============================================================================
# STEP 1: Create Supabase Account (REQUIRED - Takes 5 min)
# ============================================================================
# 1. Go to https://supabase.com
# 2. Sign up with: info@platinumbusinessteams.com
# 3. Create new project
# 4. Go to Settings → API
# 5. Copy your Project URL and keys below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase
SUPABASE_SERVICE_KEY=your-service-role-key-from-supabase

# ============================================================================
# STEP 2: Generate Security Keys (REQUIRED - Takes 1 min)
# ============================================================================
# Run this in Terminal:
#   openssl rand -base64 32
# Copy the output twice (once for each below):

JWT_SECRET=paste_random_generated_string_here
ENCRYPTION_KEY=paste_random_generated_string_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_APP_NAME=ZEPHYRIX
NEXT_PUBLIC_APP_URL=https://zephyrix.platinumbusinessteams.com
NEXT_PUBLIC_SYSTEM_OWNER_EMAIL=info@platinumbusinessteams.com
NODE_ENV=production

# ============================================================================
# OPTIONAL: Add these LATER when you have the API keys
# ============================================================================
# You can leave these blank for now - platform works without them

# For payments (add when ready):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# For task execution (add when ready):
CLAUDE_API_KEY=

# For email notifications (add when ready):
HIGHLEVEL_API_KEY=

# ============================================================================
# SUMMARY: What you need to do
# ============================================================================
# 1. Create Supabase account (free.supabase.com) - 5 minutes
# 2. Copy 3 Supabase values into STEP 1 section above
# 3. Generate 2 random strings (openssl rand -base64 32) - 1 minute
# 4. Paste them into STEP 2 section above
# 5. Save this file as .env.local in your project root
# 6. Done! Push to GitHub and deploy to Vercel
#
# Total setup time: ~10 minutes
# Platform will be LIVE and WORKING immediately
# ============================================================================
